{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.ts",
  // Must not exceed the installed workerd runtime (1.20260820.1);
  // a future date fails local dev with "compatibility date is in the future".
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],

  // The statically exported Next site. Assets are matched first; anything that
  // is not an asset (i.e. /api/contact) falls through to the Worker.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // Native rate limiter. Correct across isolates and colos, unlike an
  // in-memory Map. The binding only allows a 10s or 60s window.
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],

  "observability": { "enabled": true }
}
